  "components": {
    "schemas": {
      "AppointmentCreate": {
        "properties": {
          "vehicle_id": {
            "type": "integer",
            "title": "Vehicle Id"
          },
          "service_id": {
            "type": "integer",
            "title": "Service Id"
          },
          "slot_id": {
            "type": "integer",
            "title": "Slot Id"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "vehicle_id",
          "service_id",
          "slot_id"
        ],
        "title": "AppointmentCreate"
      },
      "AppointmentOut": {
        "properties": {
          "appointment_id": {
            "type": "integer",
            "title": "Appointment Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "IN_PROGRESS",
              "COMPLETED",
              "CANCELLED",
              "REJECTED"
            ],
            "title": "Status"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "reject_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reject Reason"
          },
          "change_count": {
            "type": "integer",
            "title": "Change Count"
          },
          "customer": {
            "$ref": "#/components/schemas/_CustomerRef"
          },
          "vehicle": {
            "$ref": "#/components/schemas/VehicleOut"
          },
          "service": {
            "$ref": "#/components/schemas/_ServiceRef"
          },
          "slot": {
            "$ref": "#/components/schemas/_SlotRef"
          },
          "handled_by": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Handled By"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryEntry"
            },
            "type": "array",
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "appointment_id",
          "status",
          "note",
          "reject_reason",
          "change_count",
          "customer",
          "vehicle",
          "service",
          "slot",
          "handled_by",
          "created_at",
          "updated_at",
          "history"
        ],
        "title": "AppointmentOut"
      },
      "AppointmentReport": {
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "title": "From"
          },
          "to": {
            "type": "string",
            "format": "date",
            "title": "To"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "by_date": {
            "items": {
              "$ref": "#/components/schemas/ReportByDate"
            },
            "type": "array",
            "title": "By Date",
            "description": "Chỉ gồm ngày có ít nhất 1 lịch, tăng dần"
          },
          "by_status": {
            "items": {
              "$ref": "#/components/schemas/ReportByStatus"
            },
            "type": "array",
            "title": "By Status",
            "description": "Đủ cả 6 trạng thái, kể cả số 0"
          },
          "by_service": {
            "items": {
              "$ref": "#/components/schemas/ReportByService"
            },
            "type": "array",
            "title": "By Service",
            "description": "Giảm dần theo số lịch"
          }
        },
        "type": "object",
        "required": [
          "from",
          "to",
          "total",
          "by_date",
          "by_status",
          "by_service"
        ],
        "title": "AppointmentReport"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryEntry": {
        "properties": {
          "old_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "PENDING",
                  "CONFIRMED",
                  "IN_PROGRESS",
                  "COMPLETED",
                  "CANCELLED",
                  "REJECTED"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Old Status"
          },
          "new_status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "IN_PROGRESS",
              "COMPLETED",
              "CANCELLED",
              "REJECTED"
            ],
            "title": "New Status"
          },
          "changed_by": {
            "type": "integer",
            "title": "Changed By"
